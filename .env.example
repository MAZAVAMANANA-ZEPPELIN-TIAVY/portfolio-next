# Formulaire de contact (Server Action src/app/contact/actions.ts + Resend).
# Copier ce fichier en .env.local pour le développement, et déclarer les mêmes variables sur Vercel.

# Clé API Resend (https://resend.com/api-keys), permission « Sending access » suffisante.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse qui reçoit les demandes.
CONTACT_TO_EMAIL=zeppelintiavymazavamanana@gmail.com

# Expéditeur. Sans domaine vérifié chez Resend, seule onboarding@resend.dev est possible,
# et elle ne peut envoyer qu'à l'adresse du compte Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev
